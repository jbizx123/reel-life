{
  "expo": {
    "name": "Reel Life",
    "slug": "reel-life",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Cinematic Logo with Film Strips and Gradient.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/Cinematic Logo with Film Strips and Gradient.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jayden.reellife.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "We need access to save your trailer and poster to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Cinematic Logo with Film Strips and Gradient.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.jayden.reellife.app"
    },
    "web": {
      "favicon": "./assets/images/newly.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-video"
    ],
    "scheme": "reellife",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8719f843-20bd-44e9-b026-be381f115623"
      }
    }
  }
}
